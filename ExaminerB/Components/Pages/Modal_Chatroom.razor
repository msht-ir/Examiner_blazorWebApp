@using System.Globalization
@using System.Reflection
@inject FeService feService
@inject AppState appState;
@inject NavigationManager Navman
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (IsOpen)
    {
    Title = "Chatroom " + appState.SelectedChatroomName;
    <div class="modal-backdrop fade show"></div>
        <div class="modal show d-block">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                    forum <span style="color:royalblue;">@appState.SelectedChatroomName</span>
                    </div>
                    <div class="modal-body">
                    @if (_cmd == "AddNewChatroomPost")
                        {
                            <div class="mt-3">
                                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:whitesmoke;">
                                        <MudTextField T="string" Label="new post" @bind-Value="chatroomPost.PostText" Variant="Variant.Text" Lines="5" AutoResize="true" Style="width:100%;font-family:'Courier New', Courier, monospace" />
                                        <br />
                                            <div style="text-align:center">
                                            <MudButton Variant="Variant.Filled" size="Size.Small" Color="Color.Primary" Margin="Margin.Dense" @onclick="BtnInsertChatroomPost">Post</MudButton>
                                            <MudButton Variant="Variant.Filled" size="Size.Small" Color="Color.Secondary" Margin="Margin.Dense" @onclick="BtnCancelNewChat">Cancel</MudButton>
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            </div>
                        }
                    else
                        {
                            <div class="d-flex gap-2 align-items-center justify-content-Left">
                                <MudFabMenu StartIcon="@Icons.Material.Outlined.Menu" Size="Size.Medium" Color="Color.Dark" Variant="Variant.Text" Direction="Direction.Right">
                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.AddComment" Color="Color.Success" Title="Add new chat item" OnClick=" BtnCreateChatroomPost" />
                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Title="Refresh" OnClick=" ReadChatroomPosts" />
                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.FormatSize" Color="Color.Warning" Title="Font Size  تغيير انداز فونت" OnClick=" BtnChangeFontSize" />
                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.ExitToApp" Color="Color.Secondary" Title="Back" OnClick="BtnCancel" />
                                </MudFabMenu>
                            </div>
                        }
                    @foreach (ChatroomPost chatroomPost in lstChatroomPosts)
                        {
                            <div class="mt-3">
                                <MudContainer Class="mt-2 px-0">
                                    <MudCard Class="mx-0" elevation="2">
                                        <MudCardContent Style="background-color: rgba(250,250,250);">
                                        @if ((_cmd == "EditChatroomPost") && (appState.SelectedChatroomPostId == chatroomPost.ChatroomPostId))
                                            {
                                                <div class="mt-3">
                                                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                                                        <MudCard Class="mx-0">
                                                            <MudCardContent Style="background-color:whitesmoke;">
                                                            <MudTextField T="string"
                                                                          Label="EDIT :"
                                                                          @bind-Value="chatroomPost.PostText"
                                                                          Variant="Variant.Text"
                                                                          Lines="6"
                                                                          AutoResize="true"
                                                                          Style="width:100%;font-family:'Courier New', Courier, monospace" />
                                                            <br />
                                                                <div style="text-align:center">
                                                                <MudButton Variant="Variant.Outlined"
                                                                           size="Size.Small"
                                                                           Color="Color.Primary"
                                                                           Margin="Margin.Dense"
                                                                           @onclick="() => BtnUpdateChatroomPost(chatroomPost)">Update</MudButton>
                                                                <MudButton Variant="Variant.Outlined"
                                                                           size="Size.Small"
                                                                           Color="Color.Secondary"
                                                                           Margin="Margin.Dense"
                                                                           @onclick="BtnCancelNewChat">Cancel</MudButton>
                                                                </div>
                                                            </MudCardContent>
                                                        </MudCard>
                                                    </MudContainer>
                                                </div>

                                            }
                                        else
                                            {
                                            @if ((chatroomPost.PostTags & 2) == 2)
                                                {
                                                <div style="font-size:smaller;font-style:italic;color:gray;">--- edited ---</div>
                                                }
                                                <div class="d-flex align-items-center" style="font-size:smaller; font-weight:bold;color:indianred;">
                                                @PersianDate(chatroomPost.PostDateTime)
                                                </div>
                                                <div class="d-flex align-items-center" style="font-size:smaller; font-weight:bold;color:royalblue;">
                                                @chatroomPost.SenderName
                                                </div>
                                            <div style='white-space: pre-wrap;font-size:small; font-weight:normal;color:black;padding-left:10px;font-size:@(_cmd == "UseLargeFontSize" ? "large" : "small")'> @chatroomPost.PostText.Trim()</div>
                                            @if (chatroomPost.SenderId == student.UserId)
                                                {
                                                <hr />
                                                    <div style="text-align:center">
                                                        <MudFabMenu StartIcon="@Icons.Material.Outlined.Menu" Size="Size.Medium" Color="Color.Warning" Variant="Variant.Text" Direction="Direction.Right">
                                                        <MudFabMenuItem StartIcon="@Icons.Material.Filled.Edit" Color="Color.Primary" Title="edit" OnClick="() => BtnEditChatroomPost(chatroomPost.ChatroomPostId)" />
                                                        <MudFabMenuItem StartIcon="@Icons.Material.Filled.Delete" Color="Color.Secondary" Title="delete" OnClick="() => BtnDeleteChatroomPost(chatroomPost.ChatroomPostId)" />
                                                        </MudFabMenu>
                                                    </div>
                                                }
                                            }
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            </div>
                        }
                    @if (lstChatroomPosts.Count > 0)
                        {
                        <br />
                        <br />
                        <br />
                            <div class="d-flex gap-2 align-items-center justify-content-Left">
                                <MudFabMenu StartIcon="@Icons.Material.Outlined.Menu" Size="Size.Medium" Color="Color.Dark" Variant="Variant.Text" Direction="Direction.Right">
                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Title="Refresh" OnClick=" ReadChatroomPosts" />
                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.FormatSize" Color="Color.Warning" Title="Font Size  تغيير انداز فونت" OnClick=" BtnChangeFontSize" />
                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.ExitToApp" Color="Color.Secondary" Title="Back" OnClick="BtnCancel" />
                                </MudFabMenu>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter]
    public string Title
        {
        get; set;
        }
    [Parameter]
    public RenderFragment ChildContent
        {
        get; set;
        }
    [Parameter]
    public EventCallback OnClose
        {
        get; set;
        }
    ChatroomPost chatroomPost = new ChatroomPost();
    string _cmd = "";
    bool _hasFetched;
    public bool IsOpen { get; set; } = true;
    int chatroomId = 0;
    int studentId = 0;
    User student = new User();
    private MudTextField<string> reftxtSearch;
    private string chatroomPostText = "";
    public List<ChatroomPost> lstChatroomPosts = new List<ChatroomPost>();
    private bool hasScrolled = false;
    bool _help;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        student.UserId = Convert.ToInt32(appState.UserId);
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        await ReadChatroomPosts();
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    public void Open () => IsOpen = true;
    private async Task Close ()
        {
        if (OnClose.HasDelegate)
            {
            await OnClose.InvokeAsync();
            IsOpen = false;
            }
        }
    public async Task BtnCreateChatroomPost ()
        {
        chatroomPost.PostText = "";
        _cmd = "AddNewChatroomPost";
        StateHasChanged();
        }
    public async Task BtnInsertChatroomPost ()
        {
        if (chatroomPost.PostText != "")
            {
            chatroomPost.ChatroomId = Convert.ToInt32(appState.SelectedChatroomId);
            chatroomPost.SenderId = student.UserId;
            chatroomPost.PostDateTime = new DateTimeOffset(); //DateTime.UtcNow;
            int result = await feService.Create_ChatroomPost(chatroomPost);
            _cmd = "";
            await ReadChatroomPosts();
            StateHasChanged();
            }
        }
    public void BtnEditChatroomPost (int chatroomPostId)
        {
        _cmd = "EditChatroomPost";
        appState.SetSelectedChatroomPostId(chatroomPostId);
        StateHasChanged();
        }
    public async Task BtnUpdateChatroomPost (ChatroomPost post)
        {
        if (post.PostText != "")
            {
            bool result = await feService.Update_ChatroomPost(post);
            _cmd = "";
            await ReadChatroomPosts();
            StateHasChanged();
            }
        }
    private async Task BtnChangeFontSize ()
        {
        _cmd = (_cmd == "UseLargeFontSize") ? "" : "UseLargeFontSize";
        StateHasChanged();
        }
    public async Task BtnDeleteChatroomPost (int chatroomPostId)
        {
        var message = new MarkupString($"<hr>Do you want to <span style='color:indianred'>delete</span> this post?<br><br> <div style='text-align:center'><img src='/img/icoDelete1.png' width='40'/></div><br><hr>");
        bool? confirmResult = await DialogService.ShowMessageBoxAsync(title: "Confirm", markupMessage: message, yesText: "Yes", cancelText: "No");
        if (confirmResult == true)
            {
            bool result = await feService.Delete_ChatroomPost(chatroomPostId);
            if (result)
                {
                Snackbar.Add($"deleted", Severity.Info);
                _hasFetched = false;
                await ReadChatroomPosts();
                StateHasChanged();
                _hasFetched = true;
                }
            else
                {
                Snackbar.Add($"failed to delete chat", Severity.Error, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                }
            }
        }
    public async Task ReadChatroomPosts ()
        {
        student.UserId = Convert.ToInt32(appState.UserId);
        chatroomId = Convert.ToInt32(appState.SelectedChatroomId);
        lstChatroomPosts.Clear();
        lstChatroomPosts = await feService.Read_ChatroomPosts(chatroomId);
        StateHasChanged();
        }
    //convert date
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 4) == 4)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    //Exit
    public void BtnCancelNewChat ()
        {
        _cmd = "";
        StateHasChanged();
        }
    public void BtnCancel ()
        {
        appState.SetCmd("");
        Close();
        }
    }
