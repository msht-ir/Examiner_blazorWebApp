@page "/GamePattern"

@using ExaminerB.Service
@inject NavigationManager Navman
@inject AppState appState
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Examiner — Game Pattern</PageTitle>
<div class="gp-wrapper">
        <div class="gp-card">
            <div class="gp-header">
            <h5>Patterns</h5>
            <div class="player">@(string.IsNullOrEmpty(appState.UserName) ? "" : "👤 " + appState.UserName + " - " + appState.UserNickname)</div>
            </div>
            <div class="gp-body">
            @if (!running)
                {
                <!-- Settings -->
                    <div class="gp-section">
                    <div class="gp-section-title">Settings</div>
                        <div class="gp-form-row" style="margin-bottom:10px;">
                            <select class="gp-select" @bind="Level">
                            <option value="1">Level 1 — Easy</option>
                            <option value="2">Level 2</option>
                            <option value="3">Level 3</option>
                            <option value="4">Level 4</option>
                            <option value="5">Level 5</option>
                            <option value="6">Level 6 — Random</option>
                            </select>
                        </div>
                        <div class="gp-form-row">
                        <label style="color:#475569;font-size:.9rem;">Questions</label>
                        <input type="number" class="gp-input gp-input-num" placeholder="#" max="15"
                               @bind="NQ" @bind:event="oninput" @onkeyup="NQKeyUp" />
                        <button class="gp-btn gp-btn-warning" type="button" @onclick="StartClicked">▶ Start</button>
                        </div>
                    </div>
                }
            <!-- Run area -->
                <div class="gp-section">
                <div class="gp-section-title">Challenge</div>
                <div class="gp-timer">@TimerText</div>
                <div class="gp-progress">@(running || Qi > 0 ? $"{Qi} of {NQ}" : $"1 of {NQ}")</div>
                <div class="gp-pattern">@PatternText</div>
                    <div class="gp-answer-row">
                    <input type="text" class="gp-input" placeholder="Your answer…" style="width:150px;"
                           @bind="AnswerInput" @bind:event="oninput" @onkeyup="AnswerKeyUp"
                           disabled="@(!running || Tm <= 0 || Qi > NQ)" />
                        <button class="gp-btn gp-btn-success" type="button"
                            @onclick="AnswerClicked"
                            disabled="@(!running || Tm <= 0 || Qi > NQ)">
                        ✓ Answer
                        </button>
                    </div>
                </div>
            <!-- Actions -->
                <div class="gp-actions">
                <button class="gp-btn gp-btn-ghost" type="button" @onclick="HelpClicked"> Help</button>
                <button class="gp-btn gp-btn-danger" type="button" @onclick="ExitClicked"> Back to Students Page</button>
                </div>
            <!-- Results -->
                <table class="gp-table">
                    <thead>
                        <tr>
                        <th>#</th>
                        <th>Pattern</th>
                        <th>Answer</th>
                        <th>Yours</th>
                        <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Results)
                        {
                            <tr>
                            <td>@r.Index</td>
                            <td>@r.Pattern</td>
                            <td>@r.Answer</td>
                            <td>@r.Yours</td>
                                <td style="@(r.Correct ? "color:#059669;font-weight:600;" : "color:#dc2626;font-weight:600;")">
                                @(r.Correct ? "✓ Correct" : "✕ Incorrect")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

@code {
    // ---- bound UI state ----
    private string Level = "1";
    private int NQ = 2;
    private string AnswerInput = "";
    // ---- runtime state ----
    private bool running = false;
    private int Qi = 0;
    private int Tm = 0;
    private int IntSeconds = 0;
    private int X1, X2, N1, N2, N3, N4;
    private int Op1, Op2, Nx;
    private int Ans;
    private string StrHelp = "";
    private string PatternText = "[ - ] [ - ] [ - ] [ - ]";
    private string TimerText = "00' 00''";
    private record ResultRow (int Index, string Pattern, string Answer, string Yours, bool Correct);
    private List<ResultRow> Results = new();
    private CancellationTokenSource? _timerCts;
    private readonly Random _rng = new();
    protected override void OnInitialized ()
        {
        // Keep username intact — don't clear it (that broke the header).
        }
    private static string FmtTime (int s)
        {
        s = Math.Max(0, s);
        int m = s / 60;
        int sec = s % 60;
        return $"{m:00}' {sec:00}''";
        }
    private int Rng (int min, int max) => _rng.Next(min, max);  // [min, max)
    // ==== START ====
    private async Task StartClicked ()
        {
        if (running)
            return;
        if (!int.TryParse(Level, out int lvl) || lvl < 1 || lvl > 6)
            return;
        if (NQ < 2)
            return;

        running = true;
        Qi = 0;
        Results.Clear();
        Tm = 0;
        TimerText = FmtTime(0);
        StateHasChanged();

        int perQ = lvl switch
            {
                1 => 50,
                2 => 60,
                3 => 60,
                4 => 70,
                5 => 80,
                _ => 70
                };
        IntSeconds = NQ * perQ;

        // start countdown
        _timerCts = new CancellationTokenSource();
        _ = CountdownAsync(_timerCts.Token);

        await AskAsync();
        }
    private async Task CountdownAsync (CancellationToken token)
        {
        Tm = IntSeconds;
        await InvokeAsync(StateHasChanged);
        try
            {
            while (Tm > 0)
                {
                await Task.Delay(1000, token);
                Tm--;
                TimerText = Tm > 0 ? FmtTime(Tm) : "⏰ Time's up";
                await InvokeAsync(StateHasChanged);
                }
            }
        catch (TaskCanceledException) { /* answered all / exit */ }
        }
    // ==== ASK ====
    private async Task AskAsync ()
        {
        if (Tm <= 0)
            {
            running = false;
            return;
            }
        Qi++;
        if (Qi > NQ)
            {
            _timerCts?.Cancel();
            TimerText = "⏹ Game over";
            running = false;
            await InvokeAsync(StateHasChanged);
            return;
            }
        StrHelp = "";
        // Step 1: base numbers
        int lvl = int.Parse(Level);
        switch (lvl)
            {
            case 1:
            case 2:
            case 3:
                X1 = Rng(2, 5);
                X2 = Rng(2, 5);
                N1 = Rng(2, 5);
                break;
            case 4:
                X1 = Rng(2, 7);
                X2 = Rng(2, 7);
                N1 = Rng(2, 7);
                break;
            case 5:
                X1 = Rng(3, 10);
                X2 = Rng(3, 10);
                N1 = Rng(3, 10);
                break;
            default: // 6
                X1 = Rng(2, 10);
                X2 = Rng(2, 10);
                N1 = Rng(2, 10);
                break;
            }
        // Step 2: operators
        if (lvl == 1)
            {
            Op1 = 30;
            Op2 = Rng(1, 3); // 1 or 2
            }
        else
            {
            Op1 = Rng(1, 4) * 10;
            Op2 = (Op1 == 10 || Op1 == 20) ? 3 : Rng(1, 3);
            }
        // Step 3: hidden slot
        switch (lvl)
            {
            case 1:
            case 2:
                Nx = 4;
                break;
            case 3:
                Nx = 1;
                break;
            case 4:
                Nx = 3;
                break;
            case 5:
                Nx = 2;
                break;
            default:
                Nx = Rng(1, 5);
                break; // 1..4
            }
        // Step 4: build sequence
        switch (Op1 + Op2)
            {
            case 13:
                StrHelp = $"[ +{X1} *{X2} ]";
                N2 = (N1 + X1) * X2;
                N3 = (N2 + X1) * X2;
                N4 = (N3 + X1) * X2;
                break;
            case 23:
                StrHelp = $"[ -{X1} *{X2} ]";
                N2 = (N1 - X1) * X2;
                N3 = (N2 - X1) * X2;
                N4 = (N3 - X1) * X2;
                break;
            case 31:
                StrHelp = $"[ *{X1} +{X2} ]";
                N2 = (N1 * X1) + X2;
                N3 = (N2 * X1) + X2;
                N4 = (N3 * X1) + X2;
                break;
            case 32:
                StrHelp = $"[ *{X1} -{X2} ]";
                N2 = (N1 * X1) - X2;
                N3 = (N2 * X1) - X2;
                N4 = (N3 * X1) - X2;
                break;
            }
        // Step 5: display
        switch (Nx)
            {
            case 1:
                Ans = N1;
                PatternText = $"[ ? ] [ {N2} ] [ {N3} ] [ {N4} ]";
                break;
            case 2:
                Ans = N2;
                PatternText = $"[ {N1} ] [ ? ] [ {N3} ] [ {N4} ]";
                break;
            case 3:
                Ans = N3;
                PatternText = $"[ {N1} ] [ {N2} ] [ ? ] [ {N4} ]";
                break;
            case 4:
                Ans = N4;
                PatternText = $"[ {N1} ] [ {N2} ] [ {N3} ] [ ? ]";
                break;
            }
        AnswerInput = "";
        await InvokeAsync(StateHasChanged);
        }
    // ==== ANSWER ====
    private async Task AnswerClicked ()
        {
        if (!running || Tm <= 0 || Qi > NQ)
            return;
        if (string.IsNullOrWhiteSpace(AnswerInput))
            return;
        if (!int.TryParse(AnswerInput.Trim(), out int userAns))
            return;
        if (userAns == Ans)
            {
            Results.Add(new ResultRow(Qi, StrHelp, Ans.ToString(), userAns.ToString(), true));
            StrHelp = "";
            AnswerInput = "";
            await AskAsync();
            }
        else
            {
            Results.Add(new ResultRow(Qi, "?", "?", userAns.ToString(), false));
            AnswerInput = "";
            await InvokeAsync(StateHasChanged);
            }
        }
    private async Task AnswerKeyUp (KeyboardEventArgs e)
        {
        if (e.Key == "Enter")
            await AnswerClicked();
        }
    private async Task NQKeyUp (KeyboardEventArgs e)
        {
        if (e.Key == "Enter" && NQ > 0)
            await StartClicked();
        }
    // ==== HELP ====
    private void HelpClicked ()
        {
        Snackbar.Add(string.IsNullOrEmpty(StrHelp)
            ? "Start a game to see the pattern help."
            : StrHelp, Severity.Info);
        }
    // ==== EXIT ====
    private void ExitClicked ()
        {
        // _timerCts?.Cancel();
        // running = false;
        Navman.NavigateTo("/S_Student");
        }
    public void Dispose ()
        {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        }
    }