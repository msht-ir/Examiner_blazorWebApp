                if (confirmResult != true)
                    {
                    Snackbar.Add($"cancelled!", Severity.Info, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    return;
                    }
                //send to selected students
                //step1: get list of selected students
                List<int> lstStudentIds = new List<int>();
                _countS = 0;
                foreach (User student in lstStudents)
                    {
                    if (student.IsSelected)
                        {
                        lstStudentIds.Add(student.UserId);
                        _countS++;
                        student.IsSelected = false;
