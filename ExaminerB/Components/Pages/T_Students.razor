@page "/T_Students"
@using ClosedXML.Excel
@using Microsoft.Extensions.Hosting
@using ClosedXML
@using ExaminerB.Service
@using System.Threading.Tasks
@inject NavigationManager Navman
@inject AppState appState
@inject FeService feService
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using OfficeOpenXml;

@if (!_hasFetched)
    {
    <_Loading />
    }
else if (appState.Cmd == "CreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <EditForm Model="lstGroups" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <div style="text-align: center;">
            <p style="font-size:large;font-style:italic;color:rgb(220,220,220)">@appState.UserNickname</p>
            </div>
        <h2 style="color:royalblue; font-style:italic">Students</h2>
        @* SECTION 1 ---- SOURCES *@
        @* ROW-1 *@
            <div style="display:flex; flex-wrap:wrap; gap:1rem; justify-content:center; align-items:flex-start; margin-bottom:25px;">
            @* SEARCH - NEW.STUDENT - IMPORT *@
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0" Style="flex:1 1 430px; min-width:0; max-width:100%;">
                    <MudCard style="min-width:440px;max-width:860px;">
                        <MudCardContent Style="background-color:rgba(249,249,249);">
                        @if (_cmd == "AddNewStudent")
                            {
                            <h6 style="text-align:center; color:indianred">add a new student</h6>
                                <div tabindex="0" style="text-align:center;margin-left:30px;margin-right:30px;">
                                <MudTextField @ref="refNewUser"
                                              @bind-Value="user.UserName"
                                              Label="username"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Autocomplete="off"
                                              Class="my-textfield" />
                                <MudTextField @ref="refNickname"
                                              @bind-Value="user.UserNickname"
                                              Label="nickname"
                                              Style="font-family: 'Segoe UI';"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Autocomplete="off"
                                              Class="my-textfield" />
                                <MudTextField @ref="refNewPass"
                                              @bind-Value="user.UserPass"
                                              Label="password"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Autocomplete="off"
                                              Class="my-textfield"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Save"
                                              OnAdornmentClick="() => BtnCreateNewStudent(user.UserName, user.UserPass, user.UserNickname)"
                                              InputType="InputType.Password" />
                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="BtnCancel"
                                               Title="cancel" />
                                </div>
                            }
                        else if (_cmd == "ImportNewStudents")
                            {

                                <h6 style="text-align:center; color:indianred">
                                <MudIconButton Icon="@Icons.Material.Filled.HelpCenter"
                                               Color="Color.Tertiary"
                                               Size="Size.Medium"
                                               OnClick="BtnHelpSignupNewTeacher"
                                               Title="how to import tests from excel" />
                                import from excel
                                </h6>
                            <hr style="color:slateblue" />
                                <div>
                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="BtnCancel"
                                               Title="cancel" />
                                <InputFile OnChange="HandleImportNewStudentsExcelFileSelected" title="Refer to Examiner guide for correct Excel format" />
                                </div>
                            }
                        else if (_cmd == "showexcelworksheetstoimportnewstudents")
                            {
                            <h6 style="text-align:center; color:blueviolet">select worksheet of new students data</h6>
                                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0" Style="flex:1 1 430px; min-width:0; max-width:100%;">
                                    <MudCard style="min-width:420px;max-width:860px;">
                                        <MudCardContent Style="background-color:whitesmoke;">
                                            <div class="d-flex">
                                                <MudSelect T="string"
                                                       @ref="refWorksheets"
                                                       Label="Worksheet"
                                                       Value="WorksheetName"
                                                       ValueChanged="@((string worcksheetname) => OnWorksheetChanged(worcksheetname))"
                                                       Class="w-auto"
                                                       Variant="Variant.Text"
                                                       Margin="Margin.Dense"
                                                       Style="font-size:small;">
                                                @foreach (string ws in lstWorksheets)
                                                    {
                                                    <MudSelectItem Value="@ws">@ws</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <button class="btn btn-link" Title="import from excel" style="margin:10px;" @onclick="() => ImportNewStudentsFromExcelWorksheetAsync()">
                                                <img src="/img/icoGo1.png" width="26" />
                                                </button>
                                                <button class="btn btn-link" style="margin-right:20px;" @onclick="BtnCancel">
                                                <img src="/img/icoCancel.png" width="20" />
                                                </button>
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }
                        else
                            {
                                <div class="d-flex gap-3" style="min-width:0; flex-wrap:wrap;padding:0;" tabindex="0">
                                <MudTextField T="string"
                                              @ref="reftxtSearch"
                                              @bind-Value="strSearch"
                                              OnKeyDown="HandleKey_Searchbox"
                                              Label="Search"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              OnAdornmentClick="BtnReadStudentsBySearch"
                                              Dense="true"
                                              Style="font-family:Tahoma;"
                                              Class="my-textfield" />
                                @* MENU STUDENT *@
                                    <MudMenu Label="stn"
                                         Variant="Variant.Outlined"
                                         Color="Color.Dark"
                                         StartIcon="@Icons.Material.Filled.AccountBox"
                                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                         Style="margin-top:15px;"
                                         Size="Size.Small" Dense="true">
                                    @if (user.IsAdmin || user.IsSuperuser)
                                        {
                                            <MudMenuItem @onclick="BtnAddNewStudent">
                                                <button class="btn btn-link pulse-hover" Title=@((_help) ? "add a new student" : "")>
                                                <img src="/img/icoAdd0.png" width="18" title="new student افزودن دانشجوي جديد" />
                                                </button>
                                            add new student
                                            </MudMenuItem>
                                            <MudMenuItem @onclick="BtnImportNewStudents">
                                                <button class="btn btn-link pulse-hover" Title=@((_help) ? "import new students from excel worksheet" : "")>
                                                <img src="/img/icoExcel1.png" width="20" title="new student گرفتن دانشجويان جديد از اکسل" />
                                                </button>
                                            import from excel
                                            </MudMenuItem>
                                        }
                                        <MudMenuItem @onclick="BtnListAllStudent">
                                            <button class="btn btn-link" Title=@((_help) ? "list all students" : "")>
                                            <img src="/img/icoListAll.png" width="32" />
                                            </button>
                                        all students
                                        </MudMenuItem>
                                        <MudMenuItem @onclick="BtnCancelSearchStudent">
                                            <button class="btn btn-link" Title=@((_help) ? "clear list" : "")>
                                            <img src="/img/icoEraser.png" width="22" />
                                            </button>
                                        clear list
                                        </MudMenuItem>
                                    </MudMenu>
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            @* PART G *@
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0" Style="flex:1 1 430px; min-width:0; max-width:100%;">
                    <MudCard style="min-width:440px;max-width:860px;">
                        <MudCardContent Style="background-color:rgba(249,249,249);">
                        @if (_cmd == "AddNewGroup")
                            {
                                <div class="d-flex">
                                <MudTextField @ref="reftxtNewGroup"
                                              @bind-Value="strNewGroupName"
                                              Label="new group"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Autocomplete="off"
                                              Style="font-family:'Segoe UI'; font-size:smaller;"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Save"
                                              OnAdornmentClick="() => BtnCreateNewGroup(strNewGroupName)"
                                              Class="my-textfield" />
                                    <button class="btn btn-link" style="margin-left:20px; font-family:'Segoe UI';" Title=@((_help) ? "cancel" : "") @onclick="BtnCancel">
                                    <img src="/img/icoCancel.png" width="20" />
                                    </button>
                                </div>
                            }
                        else if (_cmd == "EditGroup")
                            {
                                <div class="d-flex">
                                <MudTextField @ref="reftxtNewGroup"
                                              @bind-Value="thisGroup.GroupName"
                                              Label="edit group"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Style="font-family: 'Segoe UI';font-size:smaller;"
                                              Autocomplete="off"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Save"
                                              OnAdornmentClick="() => BtnUpdateGroup()"
                                              Class="my-textfield" />
                                    <button class="btn btn-link" style="margin-left:20px;" Title=@((_help) ? "cancel" : "") @onclick="BtnCancel">
                                    <img src="/img/icoCancel.png" width="20" />
                                    </button>
                                </div>
                                <div>
                                    <MudSwitch @bind-Value="thisGroup.IsActive"
                                           Label="active"
                                           Color="Color.Primary"
                                           title="activate thie group"
                                           Style="margin-right:12px;margin-top:10px;"
                                           Dense="true">
                                    </MudSwitch>
                                </div>

                            }
                        else if (_cmd == "SelectExcelFileOfStudentUsernames")
                            {
                                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0" Style="flex:1 1 430px; min-width:0; max-width:100%;">
                                    <MudCard style="min-width:440px;max-width:860px;">
                                        <MudCardContent Style="background-color:whitesmoke;">
                                        <h6 style="text-align:center; color:indianred">import from excel</h6>
                                        <hr style="color:slateblue" />
                                            <div>
                                            <img src="/img/icoExcel1.png" width="28" style="margin-right:10px;" />
                                            <InputFile OnChange="HandleReadStudentsUsernamesExcelFileSelected" title="Refer to Examiner guide for correct Excel format" />
                                            <MudIconButton Icon="@Icons.Material.Filled.HelpCenter"
                                                           Color="Color.Tertiary"
                                                           Size="Size.Medium"
                                                           OnClick="BtnHelpSignupNewTeacher"
                                                           Title="how to import tests from excel" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                           Color="Color.Primary"
                                                           Size="Size.Medium"
                                                           OnClick="BtnCancel"
                                                           Title="cancel" />
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }
                        else if (_cmd == "showexcelworksheetstoreadstudentsusernames")
                            {
                                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0" Style="flex:1 1 430px; min-width:0; max-width:100%;">
                                    <MudCard style="min-width:440px;max-width:860px;">
                                        <MudCardContent Style="background-color:whitesmoke;">
                                            <div class="d-flex">
                                                <MudSelect T="string"
                                                       @ref="refWorksheets"
                                                       Label="Worksheet"
                                                       Value="WorksheetName"
                                                       ValueChanged="@((string worcksheetname) => OnWorksheetChanged(worcksheetname))"
                                                       Class="w-auto"
                                                       Variant="Variant.Text"
                                                       Margin="Margin.Dense"
                                                       Style="font-size:small;">
                                                @foreach (string ws in lstWorksheets)
                                                    {
                                                    <MudSelectItem Value="@ws">@ws</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <button class="btn btn-link" Title="import from excel" style="margin:10px;" @onclick="() => ReadStudentUsernameExcelAsync()">
                                                <img src="/img/icoGo1.png" width="28" />
                                                </button>
                                                <button class="btn btn-link" style="margin-right:20px;" @onclick="BtnCancel">
                                                <img src="/img/icoCancel.png" width="22" />
                                                </button>
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }
                        else
                            {
                                <div class="d-flex gap-3" style="min-width:0; flex-wrap:wrap;">
                                    <MudSelect T="int"
                                           @ref="refGroups"
                                           Label="group"
                                           Value="GroupId"
                                           ValueChanged="OnGroupChanged"
                                           Class="w-auto my-select"
                                           Variant="Variant.Text"
                                           Margin="Margin.Dense"
                                           Adornment="Adornment.End"
                                           AdornmentIcon="@Icons.Material.Filled.Segment"
                                           OnAdornmentClick='() => BtnReadStudents(GroupId, "G")'
                                           Style="color:royalblue;font-size:small;">
                                    <MudSelectItem Value="0">select</MudSelectItem>
                                    @foreach (var group in lstGroups)
                                        {
                                        <MudSelectItem Value="@group.GroupId"><span style="font-size:small;font-family:Tahoma;">@group.GroupName</span></MudSelectItem>
                                        }
                                    </MudSelect>
                                @* MENU GROUPS *@
                                    <MudMenu Label="grp"
                                         Variant="Variant.Outlined"
                                         Color="Color.Dark"
                                         StartIcon="@Icons.Material.Filled.Group"
                                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                         Size="Size.Small"
                                         Style="margin-top:15px;"
                                         Dense="true">
                                        <MudMenuItem @onclick="() => BtnAddStudentsToGroup()">
                                            <button class="btn btn-link" Title=@((_help) ? "add selected students to this group" : "")>
                                            <img src="/img/icoListAddNew1.png" width="30" />
                                            </button>
                                        add students to group
                                        </MudMenuItem>
                                        <MudMenuItem @onclick="() => BtnAddStudentsToGroupUsingExcel()">
                                            <button class="btn btn-link" Title=@((_help) ? "add students to this group (from excel)" : "")>
                                            <img src="/img/icoExcel1.png" width="20" />
                                            </button>
                                        import from excel
                                        </MudMenuItem>
                                        <MudMenuItem @onclick="() => BtnRemoveStudentsFromGroup()">
                                            <button class="btn btn-link" Title=@((_help) ? "remove selected students from this group" : "")>
                                            <img src="/img/icoCancel.png" width="18" />
                                            </button>
                                        <span style="color:indianred">remove</span> students from group
                                        </MudMenuItem>
                                    <MudDivider />
                                        <MudMenuItem @onclick="BtnShowGroups">
                                            <button class="btn btn-link" Title=@((_help) ? "show all groups ()" : "")>
                                            <img src="/img/icoListAll.png" width="34" />
                                            </button>
                                        <span style="color:royalblue">@_showGroups</span>
                                        </MudMenuItem>
                                    <MudDivider />
                                        <MudMenuItem @onclick="BtnAddNewGroup">
                                            <button class="btn btn-link" Title=@((_help) ? "add new group" : "")>
                                            <img src="/img/icoAdd0.png" width="22" />
                                            </button>
                                        new group
                                        </MudMenuItem>
                                        <MudMenuItem @onclick='() => BtnEditGroup(GroupId)'>
                                            <button class="btn btn-link" Title=@((_help) ? "edit group" : "")>
                                            <img src="/img/icoRename.png" width="28" />
                                            </button>
                                        edit group
                                        </MudMenuItem>
                                        <MudMenuItem @onclick='() => BtnDeleteGroup(GroupId)'>
                                            <button class="btn btn-link" Title=@((_help) ? "delete group" : "")>
                                            <img src="/img/icoDelete2.png" width="26" />
                                            </button>
                                        <span style="color:indianred">delete group</span>
                                        </MudMenuItem>
                                    <MudDivider />
                                        <MudMenuItem @onclick='() => BtnCreateNote(GroupId, 14)'>
                                            <button class="btn btn-link" Title=@((_help) ? "add note about this group" : "")>
                                            <img src="/img/icoNewNote3.png" width="22" />
                                            </button>
                                        note on group
                                        </MudMenuItem>
                                        <MudMenuItem @onclick='() => BtnReportNotes(GroupId, "G")'>
                                            <button class="btn btn-link" Title=@((_help) ? "report notes about this group" : "")>
                                            <img src="/img/icoNoteReport.png" width="20" />
                                            </button>
                                        show notes
                                        </MudMenuItem>
                                        <MudMenuItem @onclick='() => BtnReportStudent(GroupId, "G")'>
                                            <button class="btn btn-link pulse-animation" Title=@((_help) ? "report students courses and exams" : "")>
                                            <img src="/img/icoFolderS.png" width="22" />
                                            </button>
                                        goto students folders
                                        </MudMenuItem>
                                        <MudMenuItem @onclick='() => BtnReportStudentAsPdf(GroupId, "G")'>
                                            <button class="btn btn-link" Title=@((_help) ? "report courses and exams of students in this group" : "")>
                                            <img src="/img/icoPdf.png" width="22" />
                                            </button>
                                        report students folders
                                        </MudMenuItem>
                                    </MudMenu>
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            </div>
        @* ROW-2 *@
            <div style="display:flex; flex-wrap:wrap; gap:1rem; justify-content:center; align-items:flex-start;">
            @* PART C,E *@
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0" Style="flex:1 1 430px; min-width:0; max-width:100%;">
                    <MudCard style="min-width:440px;max-width:860px;min-height:140px;">
                        <MudCardContent Style="background-color:rgba(249,249,249);">
                        @* COMBO C *@
                            <div class="d-flex gap-3" style="min-width:0; flex-wrap:wrap;">
                                <MudSelect T="int"
                                       @ref="refCourses"
                                       Label="course"
                                       Value="CourseId"
                                       ValueChanged="OnCourseChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Segment"
                                       OnAdornmentClick='() => BtnReadStudents(CourseId, "C")'
                                       Style="color:royalblue;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var course in lstCourses)
                                    {
                                    <MudSelectItem Value="@course.CourseId"><span style="font-size:small;font-family:Tahoma;">@course.CourseName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* C MENU *@
                                <MudMenu Label="crs"
                                     Variant="Variant.Outlined"
                                     Color="Color.Tertiary"
                                     StartIcon="@Icons.Material.Filled.MenuBook"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Style="margin-top:15px;"
                                     Size="Size.Small" Dense="true">
                                    <MudMenuItem @onclick="() => BtnAddStudentsToCourse()">
                                        <button class="btn btn-link" Title=@((_help) ? "add selected students to: this course" : "")>
                                        <img src="/img/icoListAddNew1.png" width="32" />
                                        </button>
                                    add students
                                    </MudMenuItem>
                                @* C SUBMENU *@
                                    <MudMenu Label="Course GRANTS" Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Key" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Dense="true">
                                        <MudMenuItem @onclick='() => BtnChangeStudentCoursesStatus("activeOn")'>
                                            <button class="btn btn-link" Title=@((_help) ? "change students accesses to this course" : "")>
                                            <img src="/img/icoYesNo_Yes.png" width="20" />
                                            </button>
                                        access to course
                                        </MudMenuItem>
                                        <MudMenuItem @onclick='() => BtnChangeStudentCoursesStatus("activeOff")'>
                                            <button class="btn btn-link" Title=@((_help) ? "change students accesses to this course" : "")>
                                            <img src="/img/icoYesNo_No.png" width="20" />
                                            </button>
                                        access to course
                                        </MudMenuItem>
                                    <hr />
                                        <MudMenuItem @onclick='() => BtnChangeStudentCoursesStatus("retryOn")'>
                                            <button class="btn btn-link" Title=@((_help) ? "change student accesses to review this exam" : "")>
                                            <img src="/img/icoYesNo_Yes.png" width="20" />
                                            </button>
                                        retry tests
                                        </MudMenuItem>
                                        <MudMenuItem @onclick='() => BtnChangeStudentCoursesStatus("retryOff")'>
                                            <button class="btn btn-link" Title=@((_help) ? "change student accesses to review this exam" : "")>
                                            <img src="/img/icoYesNo_No.png" width="20" />
                                            </button>
                                        retry tests
                                        </MudMenuItem>
                                    <hr />
                                        <MudMenuItem @onclick='() => BtnChangeStudentCoursesStatus("reviewOn")'>
                                            <button class="btn btn-link" Title=@((_help) ? "change student accesses to review this exam" : "")>
                                            <img src="/img/icoYesNo_Yes.png" width="20" />
                                            </button>
                                        review tests
                                        </MudMenuItem>
                                        <MudMenuItem @onclick='() => BtnChangeStudentCoursesStatus("reviewOff")'>
                                            <button class="btn btn-link" Title=@((_help) ? "change student accesses to review this exam" : "")>
                                            <img src="/img/icoYesNo_No.png" width="20" />
                                            </button>
                                        review tests
                                        </MudMenuItem>
                                    </MudMenu>
                                @* /END SUBMENU *@
                                    <MudMenuItem @onclick='() => BtnCreateNote(CourseId, 15)'>
                                        <button class="btn btn-link" Title=@((_help) ? "add note about this course" : "")>
                                        <img src="/img/icoNewNote3.png" width="22" />
                                        </button>
                                    note on course
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnReportNotes(CourseId, "C")'>
                                        <button class="btn btn-link" Title=@((_help) ? "report notes about this course" : "")>
                                        <img src="/img/icoNoteReport.png" width="20" />
                                        </button>
                                    show notes
                                    </MudMenuItem>
                                <hr />
                                    <MudMenuItem @onclick="() => BtnGotoPageCourses()">
                                        <button class="btn btn-link" Title=@((_help) ? "goto page courses" : "")>
                                        <img src="/img/icoFolderC.png" width="24" />
                                        </button>
                                    goto courses
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnReportStudent(CourseId, "C")'>
                                        <button class="btn btn-link" Title=@((_help) ? "report courses and exams of students in this course" : "")>
                                        <img src="/img/icoFolderS.png" width="24" />
                                        </button>
                                    goto students folders
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnReportStudentAsPdf(CourseId, "C")'>
                                        <button class="btn btn-link" Title=@((_help) ? "report courses and exams of students in this course" : "")>
                                        <img src="/img/icoPdf.png" width="22" />
                                        </button>
                                    report students folders
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                            <div>
                            </div>
                        @* COMBO E *@
                            <div class="d-flex gap-3" style="min-width:0; flex-wrap:wrap;">
                                <MudSelect T="int"
                                       @ref="refExams"
                                       Label="exam"
                                       Value="ExamId"
                                       ValueChanged="OnExamChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Segment"
                                       OnAdornmentClick='() => BtnReadStudents(ExamId, "E")'
                                       Style="color:royalblue;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var exam in lstExams)
                                    {
                                    <MudSelectItem Value="@exam.ExamId"><span style="font-size:small;font-family:Tahoma;">@(exam.ExamTitle?.Substring(0, Math.Min(25, exam.ExamTitle.Length)))</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* E MENU *@
                                <MudMenu Label="exm"
                                     Variant="Variant.Outlined"
                                     Color="Color.Tertiary"
                                     StartIcon="@Icons.Material.Filled.Schedule"
