        }
    public void BtnHelpSignupNewTeacher ()
        {
        _cmd = _cmd == "guide" ? "" : "guide";
        StateHasChanged();
        }
    public void BtnCancelGuide ()
        {
        _cmd = "";
        StateHasChanged();
        }
    public void BtnCancel ()
        {
        _cmd = "";
        StateHasChanged();
        }
    public void BtnBack ()
        {
        Navman.NavigateTo("/T_SwitchBoard");
        }
    private void BtnGotoPage (string page)
        {
        string pg = page switch
            {
                "N" => "/E_NoteBooks",
                "C" => "/T_Courses"
                };
        appState.SetReturnPage("/T_Students");
        Navman.NavigateTo(pg);
        }

