            //build a dictionary once before the loop: loop will be dramatically faster
            var userIdLookup = lstStudents
                .GroupBy(u => u.UserName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First().UserId, StringComparer.OrdinalIgnoreCase);
            foreach (var row in worksheet.RowsUsed().Skip(1))
                {
                string student = row.Cell(3).GetString().Trim(); //from column C
                if (string.IsNullOrEmpty(student))
                    continue;
                lstStudentIds.Add(userIdLookup.TryGetValue(student, out int userId) ? userId : 0);
                }
            bool result = await feService.Create_StudentGroups(GroupId, lstStudentIds);
            if (result)
                {
                Snackbar.Add($"{lstStudentIds.Count()} students added to the group", Severity.Success);
                }
            else
                {
                Snackbar.Add($"failed", Severity.Error, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                }
            }
        catch (Exception ex)
            {
            Console.WriteLine($"Error in [ImportExcel2]: {ex}");
            }
        _hasFetched = true;
        lstStudents.Clear();
        _cmd = "";
        await BtnReadStudents(GroupId, "G");
        appState.SetCmd("");
        StateHasChanged();
        }
