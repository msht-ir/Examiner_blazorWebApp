    private async Task BtnSendSelectedMessagesToSelectedStudents ()
        {
        List<int> lstStudentIds = new List<int>();
        int _countS = 0;
        int _countM = 0;
        //step 0: gaurd against zero messages/students selected
        foreach (Message msg in lstMessages)
            {
            if (msg.IsSelected)
                {
                _countM++;
                }
            }
        foreach (User student in lstStudents)
            {
            if (student.IsSelected)
                {
                _countS++;
                }
            }
        if (_countM == 0)
            {
            Snackbar.Add($"select some messages", Severity.Info, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            }
        if (_countS == 0)
            {
            Snackbar.Add($"select some students", Severity.Info, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            }
        if ((_countM == 0) || (_countS == 0))
            {
            return;
            }
        //confirm
        var message = new MarkupString(@$"<hr><span style='color:indianred'>Send {_countM} </span> selected message(s) <span style='color:indianred'>To {_countS}</span> selected student(s) ?<br><br><span style='color:royalblue'>Continue </span>? <br><br> <div style='text-align:center'><img src='/img/icoEnvelopSend.png' width='40'/></div><br><hr>");
        bool? confirmResult = await DialogService.ShowMessageBoxAsync(title: "Confirm", markupMessage: message, yesText: "Yes", cancelText: "No");
        if (confirmResult != true)
            {
            Snackbar.Add($"cancelled!", Severity.Info, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            return;
            }
        //step1: get list of selected students
        foreach (User student in lstStudents)
            {
            if (student.IsSelected)
                {
                lstStudentIds.Add(student.UserId);
                _countS++;
                student.IsSelected = false;
                }
            }
        //step2: send selected messages to the students
        foreach (Message msg in lstMessages)
            {
            if (msg.IsSelected)
                {
                bool result = await feService.Create_StudentMessages(msg.MessageId, lstStudentIds, requestFeedback);
                if (result)
                    {
                    Snackbar.Add($"message sent to {_countS} students", Severity.Success);
                    }
                else
                    {
                    Snackbar.Add($"failed", Severity.Error, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    }
                }
            }
        await BtnReadStudents(MessageId, "M");
        }
