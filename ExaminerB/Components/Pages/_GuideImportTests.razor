@using ExaminerB.Service
@using System.ComponentModel.DataAnnotations
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager Navman
@inject AppState appState
@inject FeService feService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<br />
<div class="d-flex flex-column align-items-center justify-content-center text-center">
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
        <MudCard Class="mx-auto guide-card">
            <MudCardContent Class="guide-card-content">
                <!-- Language switch -->
                <div class="lang-switch-wrap">
                    <div class="lang-switch" role="group" aria-label="Language switch">
                        <button type="button"
                                class="lang-btn @(IsFa ? "" : "active")"
                                @onclick="() => SetLang(false)">
                            <i class="fas fa-globe"></i> English
                        </button>
                        <button type="button"
                                class="lang-btn @(IsFa ? "active" : "")"
                                @onclick="() => SetLang(true)">
                            <i class="fas fa-globe"></i> فارسی
                        </button>
                    </div>
                </div>
                <h4 style="color:royalblue; text-align:center;margin-bottom:30px;">@(IsFa ? "قالب فايل اکسل براي بانک سوالات درس" : "Excel format for Test-Bank of a course")</h4>
                @if (!IsFa)
                {
                    @* ==================== ENGLISH ==================== *@
                    <div class="header-strip">
                        <h1>
                            <i class="fas fa-file-import"></i>
                            Excel columns to <span class="accent">import</span> TESTS
                        </h1>
                        <p>Excel column reference for a smooth import into the Examiner database</p>
                        <span class="badge-required">
                            <i class="fas fa-check-circle"></i> ALL COLUMNS REQUIRED
                        </span>
                    </div>
                    <div class="notice-banner">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div class="notice-text">
                            <strong>All columns must be filled to prevent error in import procedure.</strong>
                            <span>Even if a value is empty, the column header must exist and contain a valid placeholder or default (e.g., 0, 'L', or empty string). Missing columns will abort the import.</span>
                        </div>
                    </div>
                    <div class="table-wrap">
                        <table class="guide-table">
                            <thead>
                                <tr><th>Col</th><th>Header</th><th>Description</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>A</td><td>Topic</td><td>course topic or name of chapter</td></tr>
                                <tr><td>B</td><td>Question</td><td>the Test string <br /> can be rtl or ltr</td></tr>
                                <tr><td>C</td><td>nOpt</td><td>number of options in this test <span class="muted">(0 – 5)</span><br />set it 0 or 1 if the test type is essay (fill-in blank, short answer)</td></tr>
                                <tr><td>D</td><td class="accent">Opt1</td><td>Option-1 of the test <span class="muted">(enter 'x' if not applicable)</span></td></tr>
                                <tr><td>E</td><td class="accent">Opt2</td><td>Option-2 of the test <span class="muted">(enter 'x' if not applicable)</span></td></tr>
                                <tr><td>F</td><td class="accent">Opt3</td><td>Option-3 of the test <span class="muted">(enter 'x' if not applicable)</span></td></tr>
                                <tr><td>G</td><td class="accent">Opt4</td><td>Option-4 of the test <span class="muted">(enter 'x' if not applicable)</span></td></tr>
                                <tr><td>H</td><td class="accent">Opt5</td><td>Option-5 of the test <span class="muted">(enter 'x' if not applicable)</span></td></tr>
                                <tr><td>I</td><td>Ans</td><td>Correct option <span class="muted">(0 – 5)</span><br />enter 0 if test type is essay</td></tr>
                                <tr><td>J</td><td>ForceLast</td><td>which option appears as the last option <span class="muted">(1 – 5)</span><br />if none: enter 0</td></tr>
                                <tr><td>K</td><td>TestRtl</td><td><span class="pill rtl">R</span> test is rtl &nbsp; <span class="pill ltr">L</span> test is ltr</td></tr>
                                <tr><td>L</td><td>OptRtl</td><td><span class="pill rtl">R</span> options are rtl &nbsp; <span class="pill ltr">L</span> options (or essay answer) are ltr</td></tr>
                                <tr><td>M</td><td>Level</td><td>difficulty level <span class="muted">(1: easy → 5: hard)</span>, default = 3</td></tr>
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    @* ==================== PERSIAN ==================== *@
                    <div class="header-strip" dir="rtl">
                        <h1>
                            <i class="fas fa-file-import"></i>
                            راهنماي ستون‌های فايل اکسل برای <span class="accent">ورود</span> سوالات هر درس
                        </h1>
                        <p>مرجع ستون‌ها برای ورود اطلاعات به ديتابيس</p>
                        <span class="badge-required">
                            <i class="fas fa-check-circle"></i> تمامی ستون‌ها الزامی هستند
                        </span>
                    </div>
                    <div class="notice-banner" dir="rtl">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div class="notice-text">
                            <strong>برای جلوگیری از خطا در فرآیند ورود، همه سلول ها باید پر شوند.</strong>
                            <span>حتی اگر مقداری خالی است، سرستون باید وجود داشته باشند و سلول ها با مقدار معتبر یا پیش‌فرض پر شوند (مانند 0، 'L' یا رشته خالی). سلول ‌های خالي باعث توقف ورود می‌شوند.</span>
                        </div>
                    </div>
                    <div class="table-wrap" dir="rtl">
                        <table class="guide-table">
                            <thead>
                                <tr><th>ستون</th><th>سرستون</th><th>توضیحات</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>A</td><td>Topic</td><td>موضوع دوره یا نام فصل</td></tr>
                                <tr><td>B</td><td>Question</td><td>متن سوال <br /> می‌تواند راست‌به‌چپ یا چپ‌به‌راست باشد</td></tr>
                                <tr><td>C</td><td>nOpt</td><td>تعداد گزینه‌ها <span class="muted">(۰ – ۵)</span><br />اگر سوال تشریحی است (جای خالی، پاسخ کوتاه) مقدار ۰ یا ۱ قرار دهید</td></tr>
                                <tr><td>D</td><td class="accent">Opt1</td><td>گزینه ۱ <span class="muted">(اگر کاربرد ندارد 'x' وارد کنید)</span></td></tr>
                                <tr><td>E</td><td class="accent">Opt2</td><td>گزینه ۲ <span class="muted">(اگر کاربرد ندارد 'x' وارد کنید)</span></td></tr>
                                <tr><td>F</td><td class="accent">Opt3</td><td>گزینه ۳ <span class="muted">(اگر کاربرد ندارد 'x' وارد کنید)</span></td></tr>
                                <tr><td>G</td><td class="accent">Opt4</td><td>گزینه ۴ <span class="muted">(اگر کاربرد ندارد 'x' وارد کنید)</span></td></tr>
                                <tr><td>H</td><td class="accent">Opt5</td><td>گزینه ۵ <span class="muted">(اگر کاربرد ندارد 'x' وارد کنید)</span></td></tr>
                                <tr><td>I</td><td>Ans</td><td>گزینه صحیح <span class="muted">(۰ – ۵)</span><br />اگر سوال تشریحی است ۰ وارد کنید</td></tr>
                                <tr><td>J</td><td>ForceLast</td><td>کدام گزینه به عنوان آخرین گزینه نمایش داده شود <span class="muted">(۱ – ۵)</span><br />در صورت عدم وجود: ۰</td></tr>
                                <tr><td>K</td><td>TestRtl</td><td><span class="pill rtl">R</span> سوال راست‌به‌چپ &nbsp; <span class="pill ltr">L</span> سوال چپ‌به‌راست</td></tr>
                                <tr><td>L</td><td>OptRtl</td><td><span class="pill rtl">R</span> گزینه‌ها راست‌به‌چپ &nbsp; <span class="pill ltr">L</span> گزینه‌ها (یا پاسخ تشریحی) چپ‌به‌راست</td></tr>
                                <tr><td>M</td><td>Level</td><td>سطح دشواری <span class="muted">(۱: آسان → ۵: سخت)</span>، پیش‌فرض = ۳</td></tr>
                            </tbody>
                        </table>
                    </div>
                }
                <div class="page-footer">
                    <i class="fas fa-info-circle"></i>
                    @(IsFa ? "قالب اکسل نسخه ۱.۰ · ورود بانک سوالات يک درس" : "Excel template version 1.0 · Testbank import")
                </div>
            </MudCardContent>
        </MudCard>
    </MudContainer>
</div>

<style>
    .guide-card {
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 12px 30px -10px rgba(0, 20, 40, 0.15);
    }

    .guide-card-content {
        background: #f8fafc;
        padding: 1.25rem 1.25rem 1rem !important;
        text-align: left;
    }

    /* language switch */
    .lang-switch-wrap {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 0.85rem;
    }

    .lang-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: #fff;
        border: 1px solid #d0ddee;
        border-radius: 60px;
        padding: 0.25rem;
        box-shadow: 0 4px 12px rgba(0, 20, 40, 0.06);
    }

    .lang-btn {
        background: transparent;
        border: none;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.4rem 0.95rem;
        border-radius: 40px;
        cursor: pointer;
        color: #4f5f73;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        line-height: 1;
    }

    .lang-btn i { font-size: 0.82rem; }

    .lang-btn.active {
        background: #0f2b4b;
        color: #fff;
        box-shadow: 0 3px 8px rgba(15, 43, 75, 0.25);
    }

    .lang-btn:not(.active):hover {
        background: #eef3fa;
        color: #0f2b4b;
    }

    /* header strip */
    .header-strip {
        background: linear-gradient(135deg, #0f2b4b 0%, #1e3a5f 100%);
        color: #fff;
        border-radius: 1.1rem;
        padding: 1.15rem 1.25rem;
        margin-bottom: 0.9rem;
        box-shadow: 0 10px 22px -10px rgba(15, 43, 75, 0.55);
    }

    .header-strip h1 {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0 0 0.3rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        letter-spacing: -0.01em;
    }

    .header-strip h1 i {
        color: #9bc7ff;
        font-size: 1.05rem;
    }

    .header-strip .accent { color: #ffb4a8; }

    .header-strip p {
        margin: 0 0 0.6rem 0;
        color: #cfe0f7;
        font-size: 0.85rem;
    }

    .badge-required {
        background: #f97316;
        color: #fff;
        padding: 0.35rem 0.85rem;
        border-radius: 40px;
        font-weight: 700;
        font-size: 0.72rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        letter-spacing: 0.03em;
        box-shadow: 0 4px 10px rgba(249, 115, 22, 0.35);
    }

    /* notice */
    .notice-banner {
        background: #fffbeb;
        border-left: 5px solid #e11d48;
        border-radius: 0.8rem;
        padding: 0.85rem 1rem;
        margin-bottom: 0.9rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        box-shadow: 0 4px 12px rgba(225, 29, 72, 0.08);
    }

    .notice-banner i {
        font-size: 1.25rem;
        color: #e11d48;
        margin-top: 0.1rem;
        flex-shrink: 0;
    }

    .notice-text strong {
        color: #9f1239;
        font-size: 0.88rem;
        display: block;
        line-height: 1.4;
    }

    .notice-text span {
        color: #4c1d24;
        font-size: 0.78rem;
        display: block;
        margin-top: 0.2rem;
        line-height: 1.5;
    }

    /* table */
    .table-wrap {
        background: #fff;
        border-radius: 0.9rem;
        border: 1px solid #e6ecf3;
        overflow: hidden;
        margin-bottom: 0.9rem;
    }

    .guide-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
        margin: 0;
    }

    .guide-table thead th {
        background: #eef4fc;
        color: #0f2b4b;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.55rem 0.7rem;
        text-align: inherit;
        border-bottom: 1px solid #dbe4ef;
    }

    .guide-table tbody td {
        padding: 0.55rem 0.7rem;
        border-bottom: 1px solid #f0f3f7;
        color: #1e293b;
        vertical-align: top;
        line-height: 1.45;
    }

    .guide-table tbody tr:last-child td { border-bottom: none; }

    .guide-table tbody tr:nth-child(even) td {
        background: #fbfdff;
    }

    .guide-table tbody td:first-child {
        font-weight: 700;
        color: #64748b;
        width: 2.5rem;
        text-align: center;
    }

    .guide-table tbody td:nth-child(2) {
        font-weight: 600;
        color: #0b1e33;
        white-space: nowrap;
    }

    .accent { color: #b91c1c; font-weight: 700; }

    .muted { color: #64748b; font-size: 0.72rem; }

    .pill {
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.1rem 0.5rem;
        border-radius: 20px;
        border: 1px solid transparent;
        margin-inline-end: 0.15rem;
    }

    .pill.rtl { background: #e6f7ec; color: #0e6b3e; border-color: #b8e0c6; }
    .pill.ltr { background: #e8f0fe; color: #1e4a7a; border-color: #b8c9e8; }

    /* footer */
    .page-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.72rem;
        color: #8095ab;
    }

    .page-footer i { font-size: 0.75rem; }

    [dir="rtl"] .page-footer { justify-content: flex-start; }
    [dir="rtl"] .header-strip h1 { flex-direction: row-reverse; justify-content: flex-end; }
    [dir="rtl"] .notice-banner {
        border-left: none;
        border-right: 5px solid #e11d48;
    }
    [dir="rtl"] .guide-table tbody td:nth-child(2) {
        font-family: 'Vazirmatn', Tahoma, sans-serif;
    }
</style>

@code {
    private bool IsFa = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var result = await sessionStorage.GetAsync<bool>("guide-lang-fa");
            if (result.Success && result.Value != IsFa)
            {
                IsFa = result.Value;
                StateHasChanged();
            }
        }
        catch { /* prerender or unavailable session */ }
    }

    private async Task SetLang(bool fa)
    {
        if (IsFa == fa) return;
        IsFa = fa;
        try { await sessionStorage.SetAsync("guide-lang-fa", fa); }
        catch { }
    }
}