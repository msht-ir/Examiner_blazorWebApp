@code {
    private bool IsFa = false;

    protected override async Task OnAfterRenderAsync (bool firstRender)
        {
        if (!firstRender)
            return;
        try
            {
            var result = await sessionStorage.GetAsync<bool>("guide-lang-fa");
            if (result.Success && result.Value != IsFa)
                {
                IsFa = result.Value;
                StateHasChanged();
                }
            }
        catch { /* prerender or unavailable session */ }
        }

    private async Task SetLang (bool fa)
        {
        if (IsFa == fa)
            return;
        IsFa = fa;
        try
            {
            await sessionStorage.SetAsync("guide-lang-fa", fa);
            }
        catch { }
        }
    }