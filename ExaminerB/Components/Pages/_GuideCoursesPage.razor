@using ExaminerB.Service
@using System.ComponentModel.DataAnnotations
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager Navman
@inject AppState appState
@inject FeService feService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<br />
<div style="text-align:left">
    <hr />
    <h5 style="color:royalblue; text-align:center;margin-bottom:30px;">@(IsFa ? "راهنماي ايجاد درس جديد، آپلود سوالات و طراحي آزمون " : "How to create a course, import tests, and make exams")</h5>
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
            <MudCard Class="mx-auto guide-card">
                <MudCardContent Class="guide-card-content">
                @* Language switch *@
                    <div class="lang-switch-wrap">
                        <div class="lang-switch" role="group" aria-label="Language switch">
                            <button type="button"
                                class="lang-btn @(IsFa ? "" : "active")"
                                @onclick="() => SetLang(false)">
                            <i class="fas fa-globe"></i> English
                            </button>
                            <button type="button"
                                class="lang-btn @(IsFa ? "active" : "")"
                                @onclick="() => SetLang(true)">
                            <i class="fas fa-globe"></i> فارسی
                            </button>
                        </div>
                    </div>
                @if (!IsFa)
                    {
                    @* <==================== ENGLISH ==================== *@
                        <div class="header-strip">
                            <h1>
                            <i class="fas fa-user-graduate"></i>
                            Quick guide for Courses, Tests and Exams for <span class="accent">Teachers </span> in Examiner
                            </h1>
                        <p>For more info please watch short videos and user manual available in author’s website</p>
                            <span class="badge-required">
                            <i class="fas fa-check-circle"></i> Read this guide before using the examiner
                            </span>
                        </div>
                        <div class="notice-banner">
                        <i class="fas fa-exclamation-triangle"></i>
                            <div class="notice-text">
                            <strong>Read short guide below about how to use Examiner as a teacher.</strong>
                                <span>
                                <br /> Each professor has a number of courses, and each course, within its own subset, has the following items:
                                <br /> A number of links that point to internet addresses, useful websites, or shared folders.
                                <br /> A number of topic headings (syllabus topics).
                                <br /> A number of tests or non-multiple-choice short-answer questions.
                                <br /> A number of exams.
                                <br /> Each test has a number of options (2 to 5).
                                <br /> For each test, the correct answer option must be specified.
                                <br /> In each test, one of the options can be designated as the option that must always be the last option.
                                <br /> For each test, its direction (right-to-left or left-to-right) must be specified.
                                <br /> For each test, the direction (right-to-left or left-to-right) of its options must be specified.
                                <br /> For each test, there is a difficulty level (from 1 to 5), and the default is 3.
                                <br /> When uploading tests and questions, the topic headings are also uploaded, but the professor can create additional topic headings himself and place some tests in them.
                                <br /> Each test or question belongs to only one topic heading.
                                <br /> In addition to uploading, the professor can add new tests or questions one by one to the question bank.
                                <br /> Create a course.
                                <br /> Add useful links related to the course.
                                <br /> To add tests to a course, click the course's tests folder icon.
                                <br /> On the tests page, click the Excel icon.
                                <br /> Select the Excel file containing the questions.
                                <br /> Select the worksheet containing the questions for this course.
                                <br /> The Excel file and worksheet must be formatted correctly. See the guide for creating the Excel file columns.
                                <br /> Along with entering the questions, the topic headings are also created.
                                <br /> To create tests or questions one by one, click the add new test icon.
                                <br /> On the create/edit test page, enter the question title and select the topic heading from the list. Specify the question's difficulty level and reading direction (whether the question and, if it is a multiple-choice question, the options are right-to-left or left-to-right).
                                <br /> If the question is multiple-choice, add the options to the question one by one.
                                <br /> Return to the courses page and, to create an exam, click the exam list icon.
                                <br /> On the exams page, create a new exam and save its name.
                                <br /> On the new exam sheet, click the edit icon and go to the exam page.
                                <br /> On the exam page, enter the exam date, time, and duration, and set the exam to active mode.
                                <br /> To add questions to the exam, you must return to the course tests page. To do this, you can use the relevant icon on this page or go to the courses page and from there go to the tests page.
                                <br /> The second way to add questions to the exam is to use the exam design section with the random selection method.
                                <br /> Open the design section on the exam page and create a new component.
                                <br /> In the exam component, enter the number of random questions, the topic heading, and the difficulty level of the questions.
                                <br /> Create more components if necessary.
                                <br /> After completing the design (creating the components), click the run components icon so that the exam questions are added to the exam randomly and according to the settings in the components.
                                <br /> To hold the exam at the specified date and time, you must add students to the exam.
                                <br /> For each student in the exam, a separate exam sheet is assigned, and the order of the questions and options is selected randomly.
                                <br /> To add students to the exam, go to the students page.
                                <br /> The students who must be added to the exam must first be listed. To do this, use the list of students in a group, the list of students in a course, or search.
                                <br /> Select all the students appearing in a list or some of them (by ticking the checkbox next to their names).
                                <br /> Then select the course name and exam name from the relevant lists and click the add students to exam icon from the menu next to the exam list.
                                <br /> Exam sheets are created for each individual student; this operation may take a little time, so be patient.
                                <br /> The exam starts automatically at the specified date and time and ends when the exam time is over.
                                <br /> During the exam, the professor can increase or decrease the exam duration.
                                <br /> During the exam, the professor can end the exam of any of the students.
                                <br /> During the exam, the professor can view the exam sheet and answers of any of the students.
                                <br /> During the exam, the professor can send messages to the exam session, and students will see the messages on the screen without needing to do anything special.
                                <br /> The professor can enable or disable each student's access to their exam sheet and answers.
                                <br /> Students can, by viewing their exam sheet, see the percentage of other students who answered each question and which option each selected.
                                <br /> Students' exam scores are calculated automatically after the exam ends.
                                <br /> For exams that include non-multiple-choice questions, the professor must specify whether the answers are correct or incorrect.
                                <br /> To do this, the professor must click the exam questions icon on the exam sheet on the exams page. Then, by opening each question in order, the students' answers to each question are listed, and the professor can mark the correct answers with one click.
                                <br /> In this way, the exam score is obtained from the sum of the score of multiple-choice questions and non-multiple-choice questions. Updating the exam score after the professor's correction is done by clicking the end exam icon (the red clock icon).
                                <br /> On the same exams page, after clicking the exam report icon, the professor can view the list of scores and the exam sheet of each student as a report.
                                <br /> Also, during the exam, the professor can see the start time or the absence of students in the exam.
                                <br /> This information is also visible in the PDF report.
                                <br /> To prepare this report, on the students page, list the exam students, then select all or some students (the checkbox next to the students' names) and click the prepare report icon in the menu next to the exam list.
                                <br />
                                <br />
                                <h6>German: </h6>
                                <br /> Jeder Professor hat eine Anzahl von Kursen, und jeder Kurs hat innerhalb seiner eigenen Teilmenge die folgenden Elemente:
                                <br /> Eine Anzahl von Links, die auf Internetadressen, nützliche Websites oder freigegebene Ordner verweisen.
                                <br /> Eine Anzahl von Themenüberschriften (Lehrplanthemen).
                                <br /> Eine Anzahl von Tests oder Kurzantwortfragen ohne Multiple-Choice.
                                <br /> Eine Anzahl von Prüfungen.
                                <br /> Jeder Test hat eine Anzahl von Optionen (2 bis 5).
                                <br /> Für jeden Test muss die Option der richtigen Antwort angegeben werden.
                                <br /> In jedem Test kann eine der Optionen als die Option festgelegt werden, die immer die letzte Option sein muss.
                                <br /> Für jeden Test muss seine Richtung (rechts-nach-links oder links-nach-rechts) angegeben werden.
                                <br /> Für jeden Test muss die Richtung (rechts-nach-links oder links-nach-rechts) seiner Optionen angegeben werden.
                                <br /> Für jeden Test gibt es einen Schwierigkeitsgrad (von 1 bis 5), und der Standardwert ist 3.
                                <br /> Beim Hochladen von Tests und Fragen werden auch die Themenüberschriften hochgeladen, aber der Professor kann selbst zusätzliche Themenüberschriften erstellen und einige Tests darin ablegen.
                                <br /> Jeder Test oder jede Frage gehört nur zu einer Themenüberschrift.
                                <br /> Zusätzlich zum Hochladen kann der Professor neue Tests oder Fragen einzeln zur Fragenbank hinzufügen.
                                <br /> Erstellen Sie einen Kurs.
                                <br /> Fügen Sie nützliche Links zum Kurs hinzu.
                                <br /> Um Tests zu einem Kurs hinzuzufügen, klicken Sie auf das Ordnersymbol für Tests des Kurses.
                                <br /> Klicken Sie auf der Testseite auf das Excel-Symbol.
                                <br /> Wählen Sie die Excel-Datei mit den Fragen aus.
                                <br /> Wählen Sie das Arbeitsblatt aus, das die Fragen für diesen Kurs enthält.
                                <br /> Die Excel-Datei und das Arbeitsblatt müssen korrekt formatiert sein. Siehe die Anleitung zum Erstellen der Spalten der Excel-Datei.
                                <br /> Zusammen mit der Eingabe der Fragen werden auch die Themenüberschriften erstellt.
                                <br /> Um Tests oder Fragen einzeln zu erstellen, klicken Sie auf das Symbol „Neuen Test hinzufügen“.
                                <br /> Geben Sie auf der Seite „Test erstellen/bearbeiten“ den Fragetitel ein und wählen Sie die Themenüberschrift aus der Liste aus. Geben Sie den Schwierigkeitsgrad der Frage und die Leserichtung an (ob die Frage und, falls es sich um eine Multiple-Choice-Frage handelt, die Optionen rechts-nach-links oder links-nach-rechts sind).
                                <br /> Wenn die Frage eine Multiple-Choice-Frage ist, fügen Sie die Optionen einzeln zur Frage hinzu.
                                <br /> Kehren Sie zur Kursseite zurück und klicken Sie, um eine Prüfung zu erstellen, auf das Symbol für die Prüfungsliste.
                                <br /> Erstellen Sie auf der Prüfungsseite eine neue Prüfung und speichern Sie ihren Namen.
                                <br /> Klicken Sie auf dem neuen Prüfungsblatt auf das Bearbeitungssymbol und gehen Sie zur Prüfungsseite.
                                <br /> Geben Sie auf der Prüfungsseite Datum, Uhrzeit und Dauer der Prüfung ein und setzen Sie die Prüfung in den aktiven Modus.
                                <br /> Um Fragen zur Prüfung hinzuzufügen, müssen Sie zur Testseite des Kurses zurückkehren. Dazu können Sie das entsprechende Symbol auf dieser Seite verwenden oder zur Kursseite gehen und von dort zur Testseite.
                                <br /> Die zweite Möglichkeit, Fragen zur Prüfung hinzuzufügen, ist die Verwendung des Prüfungsdesign-Bereichs mit der Methode der zufälligen Auswahl.
                                <br /> Öffnen Sie den Design-Bereich auf der Prüfungsseite und erstellen Sie eine neue Komponente.
                                <br /> Geben Sie in der Prüfungskomponente die Anzahl der zufälligen Fragen, die Themenüberschrift und den Schwierigkeitsgrad der Fragen ein.
                                <br /> Erstellen Sie bei Bedarf weitere Komponenten.
                                <br /> Nach Abschluss des Designs (Erstellen der Komponenten) klicken Sie auf das Symbol zum Ausführen der Komponenten, damit die Prüfungsfragen zufällig und gemäß den Einstellungen in den Komponenten zur Prüfung hinzugefügt werden.
                                <br /> Um die Prüfung zum angegebenen Datum und zur angegebenen Uhrzeit abzuhalten, müssen Sie Studenten zur Prüfung hinzufügen.
                                <br /> Für jeden Studenten in der Prüfung wird ein separates Prüfungsblatt zugewiesen, und die Reihenfolge der Fragen und Optionen wird zufällig ausgewählt.
                                <br /> Um Studenten zur Prüfung hinzuzufügen, gehen Sie zur Studentenseite.
                                <br /> Die Studenten, die zur Prüfung hinzugefügt werden sollen, müssen zuerst aufgelistet werden. Verwenden Sie dazu die Liste der Studenten einer Gruppe, die Liste der Studenten eines Kurses oder die Suche.
                                <br /> Wählen Sie alle in einer Liste angezeigten Studenten oder einige von ihnen aus (indem Sie das Kontrollkästchen neben ihren Namen anklicken).
                                <br /> Wählen Sie dann den Kursnamen und den Prüfungsnamen aus den entsprechenden Listen aus und klicken Sie im Menü neben der Prüfungsliste auf das Symbol „Studenten zur Prüfung hinzufügen“.
                                <br /> Prüfungsblätter werden für jeden einzelnen Studenten erstellt; dieser Vorgang kann etwas Zeit in Anspruch nehmen, seien Sie geduldig.
                                <br /> Die Prüfung beginnt automatisch zum angegebenen Datum und zur angegebenen Uhrzeit und endet, wenn die Prüfungszeit abgelaufen ist.
                                <br /> Während der Prüfung kann der Professor die Prüfungsdauer erhöhen oder verringern.
                                <br /> Während der Prüfung kann der Professor die Prüfung jedes einzelnen Studenten beenden.
                                <br /> Während der Prüfung kann der Professor das Prüfungsblatt und die Antworten jedes einzelnen Studenten einsehen.
                                <br /> Während der Prüfung kann der Professor Nachrichten an die Prüfungssitzung senden, und die Studenten sehen die Nachrichten auf dem Bildschirm, ohne etwas Besonderes tun zu müssen.
                                <br /> Der Professor kann den Zugriff jedes Studenten auf sein Prüfungsblatt und seine Antworten aktivieren oder deaktivieren.
                                <br /> Studenten können durch Anzeigen ihres Prüfungsblatts den Prozentsatz der anderen Studenten sehen, die jede Frage beantwortet haben, und welche Option jeder ausgewählt hat.
                                <br /> Die Prüfungsnote der Studenten wird nach Ende der Prüfung automatisch berechnet.
                                <br /> Bei Prüfungen, die Fragen ohne Multiple-Choice enthalten, muss der Professor angeben, ob die Antworten richtig oder falsch sind.
                                <br /> Dazu muss der Professor auf der Prüfungsseite auf dem Prüfungsblatt auf das Symbol für Prüfungsfragen klicken. Dann werden durch Öffnen jeder Frage der Reihe nach die Antworten der Studenten auf jede Frage aufgelistet, und der Professor kann die richtigen Antworten mit einem Klick markieren.
                                <br /> Auf diese Weise ergibt sich die Prüfungsnote aus der Summe der Note der Multiple-Choice-Fragen und der Note der Fragen ohne Multiple-Choice. Die Aktualisierung der Prüfungsnote nach der Korrektur durch den Professor erfolgt durch Klicken auf das Symbol „Prüfung beenden“ (das rote Uhr-Symbol).
                                <br /> Auf derselben Prüfungsseite kann der Professor nach dem Klicken auf das Symbol für den Prüfungsbericht die Notenliste und das Prüfungsblatt jedes Studenten als Bericht anzeigen.
                                <br /> Außerdem kann der Professor während der Prüfung die Startzeit oder die Abwesenheit der Studenten in der Prüfung sehen.
                                <br /> Diese Informationen sind auch im PDF-Bericht sichtbar.
                                <br /> Um diesen Bericht zu erstellen, listen Sie auf der Studentenseite die Prüfungsstudenten auf, wählen Sie dann alle oder einige Studenten aus (das Kontrollkästchen neben den Namen der Studenten) und klicken Sie im Menü neben der Prüfungsliste auf das Symbol „Bericht erstellen“.
                                </span>
                            </div>
                        </div>
                    @* <div class="table-wrap">
                            <table class="guide-table">
                                <thead>
                                <tr><th>Action</th><th>Guide</th></tr>
