@page "/T_SwitchBoard"
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager Navman
@inject AppState appState
@implements IDisposable
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject FeService feService

@if (!_hasFetched)
    {
    <_LoadingTimer />
    }
else if (appState.Cmd == "CreateNote")
    {
    <Modal_CreateNote OnClose="HandleModalClose" />
    }
else if (appState.Cmd == "ShowNoteInDialog")
    {
    <Modal_ShowNote OnClose="HandleModalClose" />
    }
else if (appState.Cmd == "UpdateNote")
    {
    <Modal_CreateNote OnClose="HandleModalClose" />
    }
else
    {
        <body style="background-color:white;">
            <div style="text-align: center;margin-top:30px;margin-bottom:30px;">
            @if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
                {
                    <p style="font-size:large;font-style:italic;color:royalblue">
                    <span style="font-size:small;font-style:italic;color:darkgoldenrod"> @appState.UserName - superuser </span><br /> @appState.UserNickname
                    </p>
                }
            else if ((Convert.ToInt32(appState.UserTags) & 128) == 128)
                {
                    <p style="font-size:large;font-style:italic;color:royalblue">
                    <span style="font-size:small;font-style:italic;color:silver"> @appState.UserName - admin </span><br /> @appState.UserNickname
                    </p>
                }
            else
                {
                    <p style="font-size:large;font-style:italic;color:royalblue">
                    <span style="font-size:small;font-style:italic;color:seagreen"> @appState.UserName - teacher </span><br /> @appState.UserNickname
                    </p>
                }
            </div>
            <div class="container" style="max-width:500px; margin: 0 auto; background-color:white;">
                <div style="text-align: center;">
                <hr style="color:red;margin-bottom:10px;" />
                <br />
                @* Students-Courses-Admin *@
                    <div class="d-flex gap-5 justify-content-center">
                        <button class="btn btn-link pulse-animation" style="transform: translateY(-1px);border-radius: 30%;" @onclick="GotoGroupsStudents">
                        <img src="/img/icoSwitchBoardStudents.png" width="44" title="students دانشجويان" />
                        </button>
                        <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);border-radius: 30%;" @onclick="GotoCourses">
                        <img src="/img/icoSwitchBoardCourses.png" width="46" title="courses درس ها" />
                        </button>
                    @if ((user.UserTags & 128) == 128 || (user.UserTags & 256) == 256)
                        {
                            <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);border-radius: 30%;" @onclick="BtnGotoAdminPage">
                            <img src="/img/icoAdmin.png" width="46" title="su/admin page صفحه ادمين / سوپر يوزر" />
                            </button>
                        }
                    else
                        {
                            <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);border-radius: 30%;" @onclick="BtnChangeTeacherPassword">
                            <img src="/img/icoKeys.png" width="30" title="courses پسورد" />
                            </button>
                        }
                    </div>
                <br />
                <br />
                @* SAVE-INFO-EXIT *@
                    <div class="d-flex gap-5 justify-content-center">
                        <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);margin-right:5px;border-radius: 30%;">
                        <img src="/img/icoPrinter.png" width="36" title="report گزارش آماري" />
                        </button>
                        <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);border-radius: 30%;">
                        <img src="/img/icoInfo1.png" width="34" title="Guide راهنماي اپليکيشن اگزمينر" />
                        </button>
                        <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);margin-left:5px;border-radius: 30%;" @onclick="@(() => GotoLogin())">
                        <img src="/img/icoBack2.png" width="34" title="Exit خروج" />
                        </button>
                    </div>
                <br />
                <br />
                @* Notebook-QuickNote-AddNote *@
                    <div class="d-flex gap-5 justify-content-center">
                        <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);margin-right:5px;border-radius: 30%;" @onclick="GotoNotebooks">
                        <img src="/img/icoNoteBook.png" width="48" title="notebooks دفترچه يادداشت" />
                        </button>
                        <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);border-radius: 30%;" @onclick="ReportUserNotes">
                        <img src="/img/icoNoteReport.png" width="34" title="quick notes يادداشت ها" />
                        </button>
                        <button class="btn btn-link pulse-hover" style="transform: translateY(-1px);margin-left:5px;border-radius: 30%;" @onclick="BtnCreateNote">
                        <img src="/img/icoNewNote3.png" width="34" title="new quick note يادداشت جديد" />
                        </button>
                    </div>
                <br />
                @* Accardion: TO-DO Notes *@
                    <div style="text-align: center;margin-top:10px;margin-bottom:10px;">
                        @{
                        var collapseId_due = $"collapse";
                        _clpsP = "collapse";
                        }
                        <div class="accordion-item mt-2 mb-1" style="max-width:500px; margin: 0 auto;">
                            <h4 class="accordion-header" style="background-color:rgba(252,252,252)">
                                <button class="accordion-button collapsed"
                                    style="background-color:rgba(252,252,252); height:42px;"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId_due"
                                    aria-expanded="true"
                                    aria-controls="@collapseId_due">
                                    <button class="btn btn-link" @onclick="() => BtnReadDueNotes()">
                                    <img class="pulse-hover" src="img/icoClock2.png" width="26" style="margin-right:10px;" />
                                    </button>
                                <h5 style="color:mediumslateblue">To-do notes <span style="font-size:x-small;color:indianred">@((user.UserTags & 32) == 32 ? "(\u00B1 7 days)" : "(\u00B1 3 days)")</span> </h5>
                                </button>
                            </h4>
                            <div id="@collapseId_due" class="accordion-collapse collapse" data-bs-parent="#accordionProjects">
                                <div class="accordion-body" style="background-color:rgba(254,254,254);">
                                    <div id="T1">
                                    @foreach (Note dueNotex in lstDueNotes)
                                        {
                                        var _noteDirection = ((dueNotex.NoteTags & 1) == 1) ? "text-end" : "text-start";
                                            <div class="mt-3 @_noteDirection">
                                                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                                                    <MudCard Class="mx-0">
                                                        <MudCardContent Style="background-color:whitesmoke;">
                                                            <div class="d-flex align-items-center" style="text-align:center; color:indianred; font-weight:bold;font-size:small">
                                                            @if (dueNotex.IsTodo)
                                                                {
                                                                <img class="pulse-hover" src="/img/icoClock2.png" width="20" style="margin-right:7px" />
                                                                @PersianDate(dueNotex.NoteDueDateTime)
                                                                }
                                                            else
                                                                {
                                                                @PersianDate(dueNotex.NoteDateTime)
                                                                }
                                                            </div>
                                                        <hr />
                                                            <div style="white-space: pre-wrap; font-weight:normal; font-family:'Segoe UI';font-size:small">
                                                            @if (dueNotex.NoteText.Length > 100)
                                                                {
                                                                    <div>
                                                                    @dueNotex.NoteText.Substring(0, 100) <span style="font-size:xx-small;font-weight:bold;color:indianred">[...]</span>
                                                                    </div>
                                                                }
                                                            else
                                                                {
                                                                <div style="font-weight:normal;font-family:'Segoe UI'"> @dueNotex.NoteText</div>
                                                                }
                                                            </div>
                                                        <hr>
                                                        @* TodoNotes Buttons *@
                                                            <div class="d-flex align-items-center text-start" style="text-align:center; color:indianred; font-weight:bold;font-size:small">
                                                                <MudFabMenu OpenOnMouseHover="false" StartIcon="@Icons.Material.Outlined.Menu" Size="Size.Medium" Color="Color.Dark" Variant="Variant.Text" Direction="Direction.Right">
                                                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.EditNote" Color="Color.Primary" OnClick="() => BtnEditNoteInDialog(dueNotex)" />
                                                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.Notes" Color="Color.Dark" OnClick="() => BtnShowNoteInDialog(dueNotex)" />
                                                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.AlarmOn" Color="Color.Warning" OnClick="() => BtnRemoveDueNoteTag(dueNotex)" />
                                                                <MudFabMenuItem StartIcon="@Icons.Material.Filled.Delete" Color="Color.Secondary" OnClick="() => BtnDeleteNote(dueNotex)" />
                                                                </MudFabMenu>
                                                            </div>
                                                        </MudCardContent>
                                                    </MudCard>
                                                </MudContainer>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <hr style="color:red;margin-top:50px;" />
                </div>
            <br />
            </div>
        <br />
        <br />
        </body>
    }

@code
{
    private bool _firstRender = true;
    User user = new User();
    List<Note> lstDueNotes = new List<Note>();
    public int Spacing { get; set; } = 3;
    string _cmd = "";
    public string _clpsP = ""; //collapse Accardion Projects
    public bool _hasFetched = false;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }

        user.UserId = Convert.ToInt32(appState.UserId);
        user.UserName = appState.UserName;
        user.UserPass = appState.UserPass;
        user.UserNickname = appState.UserNickname;
        user.UserRole = appState.UserRole;
        user.UserTags = Convert.ToInt32(appState.UserTags);
        await BtnReadDueNotes();
        _hasFetched = true;
        }

    protected async Task OnAfterRenderAsync ()
        {
        var result1 = await sessionStorage.GetAsync<string>("UserName");
        if (result1.Success)
            {
            appState.SetUserName(result1.Value);
            user.UserName = appState.UserName;
            StateHasChanged();
            }

        if (_firstRender)
            {
            _firstRender = false;
            var result = await sessionStorage.GetAsync<int>("UserLoginStatus");
            if (result.Success && result.Value == 1)
                {
                appState.SetUserLoginStatus(1);
                appState.SetUserLoginStatus(result.Value);
                }
            else
                {
                Navman.NavigateTo("/Login");
                }
            }
        }

    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }

    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }

    //methods
    public void GotoLogin ()
        {
        Navman.NavigateTo("/Login");
        }

    public void GotoGroupsStudents ()
        {
        Navman.NavigateTo("/T_Students");
        }

    public void GotoCourses ()
        {
        Navman.NavigateTo("/T_Courses");
        }

    public void GotoNotebooks ()
        {
        appState.SetReturnPage("/T_SwitchBoard");
        Navman.NavigateTo("/E_NoteBooks");
        }

    public void BtnGotoAdminPage ()
        {
        appState.SetReturnPage("/T_SwitchBoard");
        Navman.NavigateTo("/T_Admin");
        }

    public async Task BtnCreateNote ()
        {
        //ReferenceTypes 1:quicknote(s) 2:SectNote(s) 11:quicknote(t) 12:SectNote(t) 13:StudentNote(t) 14:GroupNote(t) 15:CourseNote(t) 16:ExamNote(t) 17:StudentExamNote(t)
        appState.SetNoteReferenceId(Convert.ToInt32(appState.UserId)); //for quickNote(t): NoteReferenceId = UserId
        appState.SetNoteReferenceType(11);
        appState.SetCmd("CreateNote");
        StateHasChanged();
        //After the Modal_CreateNote is closed, HandleModalClose will refresh the list
        //to handel close event, I added in the Modal_CreateNote: [Parameter] public EventCallback OnClose
        }

    public void ReportUserNotes ()
        {
        user.UserId = Convert.ToInt32(appState.UserId);
        appState.SetReturnPage("/T_SwitchBoard");
        Navman.NavigateTo($"/T_ReportNotes/11/{user.UserId}");
        }

    private void BtnChangeTeacherPassword ()
        {
        if ((Convert.ToInt32(appState.UserTags) & 2) == 2)
            {
            appState.SetUserLoginStatus(1);
            Navman.NavigateTo("/ChangePassword");
            }
        else
            {
            Snackbar.Add("account limitted", Severity.Warning, opt =>
            {
                opt.VisibleStateDuration = 1500;
                opt.ShowTransitionDuration = 300;
                opt.HideTransitionDuration = 300;
            });
            }
        }

    private async Task HandleModalClose ()
        {
        await BtnReadDueNotes();
        StateHasChanged();
        }

    public async Task BtnReadDueNotes ()
        {
        user.UserTags = Convert.ToInt32(appState.UserTags);
        user.UserId = Convert.ToInt32(appState.UserId);
        if ((user.UserTags & 16) == 16)
            {
            lstDueNotes = await feService.Read_DueNotes(user.UserId, ((user.UserTags & 32) == 32) ? 14 : 7);
            }

        StateHasChanged();
        }

    //convert date
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 4) == 4)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }

    public async Task BtnRemoveDueNoteTag (Note note)
        {
        var message = new MarkupString($"<hr><span style='color:indianred'>Remove</span> Todo tag from this note?<br><br><span style='font-weight:bold'>This note</span> will be a <span style='color:indianred'> simple note</span>!<br><br><div style='text-align:center'><img src='/img/icoOff.png' width='50'/></div><br><hr>");
        bool? confirmResult = await DialogService.ShowMessageBoxAsync(title: "Confirm", markupMessage: message, yesText: "Yes", cancelText: "No");
        if (confirmResult == true)
            {
            appState.SetNoteReferenceId(note.ReferenceId);
            note.NoteTags &= ~2;
            bool result = await feService.Update_Note(note);
            if (result)
                {
                lstDueNotes = await feService.Read_DueNotes(user.UserId, ((user.UserTags & 32) == 32) ? 14 : 7);
                StateHasChanged();
                }
            else
                {
                Snackbar.Add($"failed to clear Todo", Severity.Error, opt =>
                {
                    opt.VisibleStateDuration = 1500;
                    opt.ShowTransitionDuration = 300;
                    opt.HideTransitionDuration = 300;
                });
                }
            }
        }

    public async Task BtnEditNoteInDialog (Note note)
        {
        appState.SetSelectedNoteId(note.NoteId);
        appState.SetNoteReferenceId(note.ReferenceId);
        appState.SetNoteReferenceName(note.ReferenceName);
        if (appState.UserRole == "teacher")
            {
            appState.SetNoteReferenceType(12);
            }
        else if (appState.UserRole == "student")
            {
            appState.SetNoteReferenceType(2);
            }
        else
            {
            appState.SetNoteReferenceType(0);
            }

        appState.SetNoteDateTime(note.NoteDateTime.ToString("yyyy-MM-dd HH:mm"));
        appState.SetNoteDueDateTime(note.NoteDueDateTime?.ToString("yyyy-MM-dd HH:mm")); //use ? becuse note.NoteDueDateTime is nullable
        appState.SetNoteText(note.NoteText);
        appState.SetNoteCreatorId(note.CreatorId);
        appState.SetNoteIsRtl(note.IsRtl);
        appState.SetNoteIsTodo(note.IsTodo);
        appState.SetCmd("UpdateNote");
        await BtnReadDueNotes();
        StateHasChanged();
        //After the Modal_CreateNote is closed, HandleModalClose will refresh the list
        //to handel close event, I added in the Modal_CreateNote: [Parameter] public EventCallback OnClose
        }

    public async Task BtnShowNoteInDialog (Note note)
        {
        appState.SetSelectedNoteId(note.NoteId);
        appState.SetNoteReferenceId(note.ReferenceId);
        appState.SetNoteReferenceType(note.ReferenceType);
        appState.SetNoteReferenceName(note.ReferenceName);
        appState.SetNoteDateTime(note.NoteDateTime.ToString("yyyy-MM-dd HH:mm"));
        appState.SetNoteDueDateTime(note.NoteDueDateTime?.ToString("yyyy-MM-dd HH:mm")); //use ? becuse note.NoteDueDateTime is nullable
        appState.SetNoteText(note.NoteText);
        appState.SetNoteCreatorId(note.CreatorId);
        appState.SetNoteIsRtl(note.IsRtl);
        appState.SetNoteIsTodo(note.IsTodo);
        appState.SetCmd("ShowNoteInDialog");
        StateHasChanged();
        }

    public async Task BtnDeleteNote (Note note)
        {
        var message = new MarkupString($"<hr><span style='color:indianred'>Delete</span> this note?<br><br><span style='font-weight:bold'>This note</span> will be <span style='color:indianred'>deleted</span>!<br><br><div style='text-align:center'><img src='/img/icoDelete1.png' width='70'/></div><br><hr>");
        bool? confirmResult = await DialogService.ShowMessageBoxAsync(title: "Confirm", markupMessage: message, yesText: "Yes", cancelText: "No");
        if (confirmResult == true)
            {
            appState.SetNoteReferenceId(note.ReferenceId);
            bool result = await feService.Delete_Note(note.NoteId);
            if (result)
                {
                Snackbar.Add($"deleted", Severity.Warning);
                user.UserId = Convert.ToInt32(appState.UserId);
                await BtnReadDueNotes();
                StateHasChanged();
                }
            else
                {
                Snackbar.Add($"failed to delete note", Severity.Error, opt =>
                {
                    opt.VisibleStateDuration = 1500;
                    opt.ShowTransitionDuration = 300;
                    opt.HideTransitionDuration = 300;
                });
                }
            }
        }

    }
