@page "/GameCalculation"

@using ExaminerB.Service
@inject NavigationManager Navman
@inject AppState appState
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Examiner — Calculation</PageTitle>
    <div class="gc-wrapper">
        <div class="gc-card">
            <div class="gc-header">
            <h5>Calculate </h5>
            <div class="player">@(string.IsNullOrEmpty(appState.UserName) ? "" : "👤 " + appState.UserName + " - "+appState.UserNickname)</div>
            </div>
            <div class="gc-body">
            @* SETTINGS *@
                <div class="gc-section">
                <div class="gc-section-title">Operand 1</div>
                    <div class="gc-row">
                    <span class="gc-label">N1</span>
                    <input type="number" class="gc-input gc-input-sm" placeholder="int" max="3" min="0" @bind="N1int" @bind:event="oninput">
                    <span class="gc-sep">.</span>
                    <input type="number" class="gc-input gc-input-sm" placeholder="dec" max="3" min="0" @bind="N1dec" @bind:event="oninput">
                    </div>
                <div class="gc-section-title" style="margin-top:14px;">Allowed operators</div>
                    <div class="gc-checks">
                    <label class="gc-check @(Op1 ? "active" : "")"><input type="checkbox" @bind="Op1"> + </label>
                    <label class="gc-check @(Op2 ? "active" : "")"><input type="checkbox" @bind="Op2"> − </label>
                    <label class="gc-check @(Op3 ? "active" : "")"><input type="checkbox" @bind="Op3"> × </label>
                    <label class="gc-check @(Op4 ? "active" : "")"><input type="checkbox" @bind="Op4"> ÷ </label>
                    </div>
                <div class="gc-section-title" style="margin-top:14px;">Operand 2</div>
                    <div class="gc-row">
                    <span class="gc-label">N2</span>
                    <input type="number" class="gc-input gc-input-sm" placeholder="int" max="3" min="0" @bind="N2int" @bind:event="oninput">
                    <span class="gc-sep">.</span>
                    <input type="number" class="gc-input gc-input-sm" placeholder="dec" max="3" min="0" @bind="N2dec" @bind:event="oninput">
                    </div>
                <hr />
                    <div class="gc-row" style="margin-top:14px;">
                    <span class="gc-label">⏱ Time</span>
                    <input type="number" class="gc-input gc-input-md" placeholder="sec" max="200" @bind="TmInput">
                    <span style="color:#94a3b8;font-size:.85rem;">secs</span>
                        <button class="gc-btn gc-btn-warning" style="width:100px;margin-left:30px;"
                            type="button" @onclick="StartClicked" disabled="@running">
                        ▶ Start
                        </button>
                    </div>
                </div>
            @* RUN *@
                <div class="gc-section">
                <div class="gc-section-title">Question</div>
                <div class="gc-timer">@FmtTime(Tm)</div>
                <div class="gc-question">@(string.IsNullOrEmpty(Qstn) ? "—" : Qstn)</div>

                    <div class="gc-answer-row">
                    <input type="number" step="any" class="gc-input gc-input-md"
                           placeholder="Answer?"
                           @bind="AnswerInput"
                           @bind:event="oninput"
                           @onkeyup="AnswerKeyUp"
                           disabled="@(!running || Tm <= 0)" />
                        <button class="gc-btn gc-btn-success" type="button"
                            @onclick="AnswerClicked"
                            disabled="@(!running || Tm <= 0)">
                        ✓ Answer
                        </button>
                    </div>
                </div>
            @* ACTIONS *@
                <div class="gc-actions">
                <button class="gc-btn gc-btn-danger" type="button" @onclick="ExitClicked">Back to Students Page</button>
                </div>
            @* RESULTS *@
                <table class="gc-table">
                    <thead>
                        <tr>
                        <th>Question</th>
                        <th>Answer</th>
                        <th>Yours</th>
                        <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Results)
                        {
                            <tr>
                            <td>@row.Question</td>
                            <td>@row.Answer</td>
                            <td>@row.Yours</td>
                                <td style="@(row.Correct ? "color:#059669;font-weight:600;" : "color:#dc2626;font-weight:600;")">
                                @(row.Correct ? "✓ Correct" : "✕ Incorrect")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        <div class="gc-output">@OutputText</div>
        </div>
    </div>

@code {
    // ---- bound UI state ----
    private int N1int = 1, N1dec = 0, N2int = 1, N2dec = 0;
    private bool Op1 = true, Op2 = true, Op3 = false, Op4 = false;
    private int TmInput = 60;
    private string AnswerInput = "";
    // ---- runtime state ----
    private bool running = false;
    private int Tm = 0; // remaining seconds
    private string Qstn = "";
    private double Ans = 0;
    private CancellationTokenSource? _cts;
    private string OutputText = "";

    private record ResultRow (string Question, string Answer, double Yours, bool Correct);
    private List<ResultRow> Results = new();
    protected override void OnInitialized ()
        {        
        }
    private static string FmtTime (int s)
        {
        s = Math.Max(0, s);
        int m = s / 60;
        int sec = s % 60;
        return $"{m:00}' {sec:00}''";
        }
    private int OperatorMask ()
        {
        int gt = 0;
        if (Op1)
            gt |= 1;
        if (Op2)
            gt |= 2;
        if (Op3)
            gt |= 4;
        if (Op4)
            gt |= 8;
        return gt == 0 ? 1 : gt;   // default to "+" if nothing checked
        }
    private void StartClicked ()
        {
        if (running)
            return;
        if (TmInput <= 0)
            return;

        _ = RunGameAsync();
        }
    private async Task RunGameAsync ()
        {
        running = true;
        Results.Clear();
        OutputText = "";
        StateHasChanged();

        int gt = OperatorMask();

        while (TmInput > 0)   // outer loop: one question per iteration
            {
            // roll operands fresh for each question (matches JS btnStart_click)
            double n1 = Math.Floor(Random.Shared.NextDouble() * Math.Pow(10, N1int + N1dec) + 1) / Math.Pow(10, N1dec);
            double n2 = Math.Floor(Random.Shared.NextDouble() * Math.Pow(10, N2int + N2dec) + 1) / Math.Pow(10, N2dec);

            // pick a valid operator
            int op;
            do
                {
                op = Random.Shared.Next(1, 5);
                }
            while (((1 << (op - 1)) & gt) != (1 << (op - 1)));

            double a;
            switch (op)
                {
                case 1:
                    Qstn = $"{n1} + {n2}";
                    a = Math.Round((n1 + n2) * 10) / 10;
                    break;
                case 2:
                    if (n2 > n1)
                        (n1, n2) = (n2, n1);
                    Qstn = $"{n1} − {n2}";
                    a = Math.Round((n1 - n2) * 10) / 10;
                    break;
                case 3:
                    Qstn = $"{n1} × {n2}";
                    a = Math.Round((n1 * n2) * 10) / 10;
                    break;
                default:
                    if (n2 > n1)
                        (n1, n2) = (n2, n1);
                    Qstn = $"{n1} ÷ {n2}";
                    a = Math.Round((n1 / n2) * 10) / 10;
                    break;
                }
            Ans = a;
            AnswerInput = "";
            Tm = TmInput;
            _cts = new CancellationTokenSource();
            StateHasChanged();

            // per-question countdown; stops when answered correctly or time runs out
            bool timeOver = false;
            try
                {
                while (Tm > 0 && running)
                    {
                    await Task.Delay(1000, _cts.Token);
                    Tm--;
                    StateHasChanged();
                    }
                if (Tm <= 0)
                    timeOver = true;
                }
            catch (TaskCanceledException) { /* answered correctly → cancelled */ }

            if (timeOver)
                {
                OutputText += Qstn + " — Time over\n";
                StateHasChanged();
                // loop continues, starts a fresh question (matches JS)
                }
            else
                {
                // answered correctly → next question; loop continues
                }
            }

        running = false;
        StateHasChanged();
        }
    private void AnswerClicked ()
        {
        if (!running || Tm <= 0)
            return;

        if (string.IsNullOrWhiteSpace(AnswerInput))
            return;
        if (!double.TryParse(AnswerInput, out double userAns))
            return;

        userAns = Math.Truncate(userAns * 10) / 10;

        if (Math.Abs(userAns - Ans) < 0.1)
            {
            Results.Add(new ResultRow(Qstn, Ans.ToString(), userAns, true));
            AnswerInput = "";
            // stop the current question's countdown → outer loop starts next question
            _cts?.Cancel();
            }
        else
            {
            Results.Add(new ResultRow(Qstn, "?", userAns, false));
            Snackbar.Add($"Incorrect — try again! You have {Tm} seconds left.", Severity.Warning);
            AnswerInput = "";
            }
        }
    private void AnswerKeyUp (KeyboardEventArgs e)
        {
        if (e.Key == "Enter")
            AnswerClicked();
        }
    private void ExitClicked ()
        {
        // _cts?.Cancel();
        // running = false;
        Navman.NavigateTo("/S_Student");
        }
    public void Dispose ()
        {
        _cts?.Cancel();
        _cts?.Dispose();
        }
    }